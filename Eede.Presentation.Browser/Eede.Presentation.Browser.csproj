<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainAssemblyFileName>Eede.Presentation.Browser.dll</WasmMainAssemblyFileName>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmBuildNative>true</WasmBuildNative>
    <RootNamespace>Eede.Presentation.Browser</RootNamespace>
    <AssemblyName>Eede.Presentation.Browser</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="8.3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eede.Presentation\Eede.Presentation.csproj" />
  </ItemGroup>
</Project>
