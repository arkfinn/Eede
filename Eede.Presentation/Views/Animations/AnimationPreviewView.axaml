<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Eede.Presentation.ViewModels.Animations"
			 xmlns:view="using:Eede.Presentation.Views.Animations"
			 mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="450"
			 x:Class="Eede.Presentation.Views.Animations.AnimationPreviewView"
			 x:DataType="vm:AnimationViewModel"
			 x:Name="PreviewRoot">
	<Design.DataContext>
		<vm:AnimationViewModel />
	</Design.DataContext>

	<DockPanel LastChildFill="True">
		<StackPanel DockPanel.Dock="Top" Spacing="4" Margin="6,4">
			<StackPanel.Styles>
				<Style Selector="ToggleButton.attention">
					<Style.Animations>
						<Animation Duration="0:0:1" IterationCount="2">
							<KeyFrame Cue="0%">
								<Setter Property="Opacity" Value="1.0"/>
							</KeyFrame>
							<KeyFrame Cue="50%">
								<Setter Property="Opacity" Value="0.3"/>
							</KeyFrame>
							<KeyFrame Cue="100%">
								<Setter Property="Opacity" Value="1.0"/>
							</KeyFrame>
						</Animation>
					</Style.Animations>
				</Style>
			</StackPanel.Styles>

			<!-- Section: Editing Mode (薄型化) -->
			<ToggleButton IsChecked="{Binding IsAnimationMode}"
						  Classes="attention"
						  HorizontalAlignment="Stretch"
						  Height="28" Padding="4,0">
				<ToggleButton.Styles>
					<Style Selector="ToggleButton">
						<Setter Property="Content">
							<Template>
								<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
									<Image Source="avares://Eede.Presentation/Assets/Tools/tool_animation_record.png" Width="14" Height="14"/>
									<TextBlock Text="アニメーション編集モード" FontSize="11" VerticalAlignment="Center"/>
								</StackPanel>
							</Template>
						</Setter>
						<Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}"/>
					</Style>
					<Style Selector="ToggleButton:checked">
						<Setter Property="Content">
							<Template>
								<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
									<Image Source="avares://Eede.Presentation/Assets/Tools/tool_animation_record.png" Width="14" Height="14"/>
									<TextBlock Text="アニメーション編集モード" FontSize="11" Foreground="{DynamicResource AccentContrastBrush}" VerticalAlignment="Center"/>
								</StackPanel>
							</Template>
						</Setter>
						<Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
						<Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}"/>
					</Style>
				</ToggleButton.Styles>
			</ToggleButton>

			<Separator Margin="0,1"/>

			<!-- Section: Pattern Management (メニュー集約) -->
			<Grid ColumnDefinitions="*, Auto">
				<ComboBox Grid.Column="0" ItemsSource="{Binding Patterns}"
						  SelectedItem="{Binding SelectedPattern}"
						  HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="28">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<Button Grid.Column="1" Classes="tool" ToolTip.Tip="パターンメニュー" Margin="2,0,0,0" Width="28" Height="28">
					<TextBlock Text="⋮" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight">
							<MenuItem Header="新規パターン"
									  Command="{Binding CreatePatternCommand}"
									  CommandParameter="New Pattern">
								<MenuItem.Icon>
									<PathIcon Data="{StaticResource NoteAddIconGeometry}" Classes="icon" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="パターン削除"
									  Command="{Binding RemovePatternCommand}">
								<MenuItem.Icon>
									<TextBlock Text="✕" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</MenuItem.Icon>
							</MenuItem>
							<Separator />
							<MenuItem Header="読み込み..."
									  Command="{Binding ImportCommand}"
									  CommandParameter="{Binding #PreviewRoot.FileStorage}">
								<MenuItem.Icon>
									<PathIcon Data="{StaticResource FolderOpenIconGeometry}" Classes="icon" />
								</MenuItem.Icon>
							</MenuItem>
							<!-- Desktop 保存 -->
							<MenuItem Header="保存..."
									  IsVisible="{Binding IsDesktopPlatform}"
									  Command="{Binding ExportCommand}"
									  CommandParameter="{Binding #PreviewRoot.FileStorage}">
								<MenuItem.Icon>
									<PathIcon Data="{StaticResource SaveIconGeometry}" Classes="icon" />
								</MenuItem.Icon>
							</MenuItem>
							<!-- Web ダウンロード -->
							<MenuItem Header="ダウンロード..."
									  IsVisible="{Binding IsBrowserPlatform}"
									  Command="{Binding ExportCommand}"
									  CommandParameter="{Binding #PreviewRoot.FileStorage}">
								<MenuItem.Icon>
									<PathIcon Data="{StaticResource DownloadIconGeometry}" Classes="icon" />
								</MenuItem.Icon>
							</MenuItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</Grid>

			<Separator Margin="0,1"/>

			<!-- Section: Grid Settings (インライン化) -->
			<Grid ColumnDefinitions="Auto, *, 6, Auto, *">
				<TextBlock Grid.Column="0" Text="W:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,2,0"/>
				<ComboBox Grid.Column="1" ItemsSource="{Binding GridSizeList}"
						  SelectedItem="{Binding GridWidth}"
						  HorizontalAlignment="Stretch" Height="26"/>
				<TextBlock Grid.Column="3" Text="H:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,2,0"/>
				<ComboBox Grid.Column="4" ItemsSource="{Binding GridSizeList}"
						  SelectedItem="{Binding GridHeight}"
						  HorizontalAlignment="Stretch" Height="26"/>
			</Grid>

			<Separator Margin="0,1"/>

			<!-- Section: Playback -->
			<Button Command="{Binding TogglePlayCommand}" Classes="primary" HorizontalAlignment="Stretch" Height="30">
				<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
					<Path Fill="{DynamicResource AccentContrastBrush}"
						  Data="M 0,0 L 10,7 L 0,14 Z"
						  IsVisible="{Binding !IsPlaying}"
						  VerticalAlignment="Center"/>
					<Rectangle Fill="{DynamicResource AccentContrastBrush}" Width="10" Height="14"
							   IsVisible="{Binding IsPlaying}"
							   VerticalAlignment="Center">
						<Rectangle.OpacityMask>
							<VisualBrush Stretch="None">
								<VisualBrush.Visual>
									<Grid ColumnDefinitions="3, 4, 3">
										<Rectangle Grid.Column="0" Fill="Black" Width="3"/>
										<Rectangle Grid.Column="2" Fill="Black" Width="3"/>
									</Grid>
								</VisualBrush.Visual>
							</VisualBrush>
						</Rectangle.OpacityMask>
					</Rectangle>
					<TextBlock Text="{Binding IsPlaying, Converter={StaticResource PlayPauseTextConverter}, FallbackValue='Play'}"
							   Foreground="{DynamicResource AccentContrastBrush}"
							   VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
				</StackPanel>
			</Button>

			<!-- Preview Header / Collapse Toggle -->
			<ToggleButton IsChecked="{Binding IsPreviewExpanded, Mode=TwoWay}"
						  HorizontalAlignment="Stretch" Height="24" Padding="4,0"
						  Background="Transparent" BorderThickness="0" Margin="0,2,0,0">
				<Grid ColumnDefinitions="*, Auto">
					<TextBlock Grid.Column="0" Text="Preview" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1" Text="{Binding IsPreviewExpanded, Converter={StaticResource PlayPauseTextConverter}, ConverterParameter='arrow'}"
							   Foreground="{DynamicResource TextBrush}" FontSize="10" VerticalAlignment="Center"/>
				</Grid>
			</ToggleButton>
		</StackPanel>

		<!-- Preview Image Frame -->
		<Border BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" Margin="6,0,6,6"
				MinHeight="80" CornerRadius="0" IsVisible="{Binding IsPreviewExpanded}">
			<Panel Background="DarkGray">
				<Panel.Background>
					<ImageBrush Source="avares://Eede.Presentation/Assets/Tiles/InvisibleBackground.png"
								Stretch="None" TileMode="Tile"
								SourceRect="0,0,16,16" DestinationRect="0,0,16,16"/>
				</Panel.Background>
				<Image Source="{Binding PreviewBitmap}"
					   Stretch="Uniform"
					   RenderOptions.BitmapInterpolationMode="None"
					   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Panel>
		</Border>
	</DockPanel>
</UserControl>