<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Eede.Presentation.ViewModels.DataEntry"
             xmlns:local="clr-namespace:Eede.Presentation.Views.DataEntry"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="250"
             x:DataType="vm:PaletteContainerViewModel"
             x:Class="Eede.Presentation.Views.DataEntry.PaletteContainer">
  <TabControl x:Name="PART_TabControl"
              ItemsSource="{Binding Tabs}"
              SelectedItem="{Binding SelectedTab}"
              SelectionChanged="OnTabControlSelectionChanged">
    <TabControl.Template>
      <ControlTemplate TargetType="TabControl">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,2">
              <ScrollViewer Grid.Column="0"
                            x:Name="PART_HeaderScrollViewer"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
              <Button Grid.Column="1"
                      Classes="tool"
                      Padding="2"
                      Margin="2,0"
                      Click="OnShowTabListClick"
                      ToolTip.Tip="開いているパレット一覧">
                <PathIcon Data="{StaticResource ArrowDownwardIconGeometry}" Width="10" Height="10" />
              </Button>
            </Grid>
            <Grid ColumnDefinitions="Auto, *">
              <ContentPresenter Grid.Column="0"
                                Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
              <ContentPresenter Grid.Column="1"
                                Content="{Binding SideContent, RelativeSource={RelativeSource AncestorType={x:Type local:PaletteContainer}}}"
                                Margin="4,0,0,0"
                                VerticalAlignment="Top" />
            </Grid>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </TabControl.Template>
    <TabControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </TabControl.ItemsPanel>
    <TabControl.ItemTemplate>
      <DataTemplate x:DataType="vm:PaletteTabViewModel">
        <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent" ToolTip.Tip="{Binding ToolTipText}">
          <StackPanel.ContextMenu>
            <ContextMenu>
              <MenuItem Header="保存"
                        Command="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).SaveTabCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding FilePath, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Separator />
              <MenuItem Header="閉じる"
                        Command="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).CloseTabCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="これ以外をすべて閉じる"
                        Command="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).CloseOthersCommand}"
                        CommandParameter="{Binding}" />
            </ContextMenu>
          </StackPanel.ContextMenu>
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="80" TextTrimming="CharacterEllipsis" />
          <Button Classes="tool" Padding="2"
                  IsVisible="{Binding IsClosable}"
                  Command="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).CloseTabCommand}"
                  CommandParameter="{Binding}">
            <PathIcon Data="{StaticResource DismissIconGeometry}" Width="10" Height="10" />
          </Button>
        </StackPanel>
      </DataTemplate>
    </TabControl.ItemTemplate>
    <TabControl.ContentTemplate>
      <DataTemplate x:DataType="vm:PaletteTabViewModel">
        <Grid ColumnDefinitions="272, Auto" HorizontalAlignment="Left">
          <local:PaletteForm Grid.Column="0"
                             BorderBrush="Black"
                             BorderThickness="1"
                             Palette="{Binding Palette}"
                             IsRegisterMode="{Binding $parent[local:PaletteContainer].IsRegisterMode}"
                             PointerLeftButtonPressedCommand="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).FetchColorCommand}"
                             PointerRightButtonPressedCommand="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).ApplyColorCommand}"
                             PointerColorReplacedCommand="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).ReplaceColorCommand}" />
          <StackPanel Grid.Column="1" Orientation="Vertical" Margin="4 0">
            <Button Classes="tool" ToolTip.Tip="パレットを開く"
                    Command="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).LoadPaletteCommand}"
                    CommandParameter="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:PaletteContainer}}}">
              <PathIcon Data="{StaticResource FolderOpenIconGeometry}" Classes="icon" />
            </Button>

            <!-- Desktop 保存ボタン群 -->
            <Button Classes="tool" ToolTip.Tip="パレットを保存する"
                    IsVisible="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).IsDesktopPlatform}"
                    Command="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).SavePaletteCommand}"
                    CommandParameter="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:PaletteContainer}}}">
              <PathIcon Data="{StaticResource SaveIconGeometry}" Classes="icon" />
            </Button>

            <Button Classes="tool" ToolTip.Tip="名前を付けて保存"
                    IsVisible="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).IsDesktopPlatform}"
                    Command="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).SavePaletteAsCommand}"
                    CommandParameter="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:PaletteContainer}}}">
              <PathIcon Data="{StaticResource SaveAsIconGeometry}" Classes="icon" />
            </Button>

            <!-- Web/Browser ダウンロードボタン -->
            <Button Classes="tool" ToolTip.Tip="パレットをダウンロード"
                    IsVisible="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).IsBrowserPlatform}"
                    Command="{Binding $parent[local:PaletteContainer].((vm:PaletteContainerViewModel)DataContext).SavePaletteCommand}"
                    CommandParameter="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:PaletteContainer}}}">
              <PathIcon Data="{StaticResource DownloadIconGeometry}" Classes="icon" />
            </Button>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </TabControl.ContentTemplate>
  </TabControl>
</UserControl>
