<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Eede.Presentation.ViewModels.DataEntry"
        xmlns:local="using:Eede.Presentation.Views.DataEntry"
        x:Class="Eede.Presentation.Views.DataEntry.ScalingDialogView"
        x:DataType="vm:ScalingDialogViewModel"
        Title="拡大縮小"
        Width="350" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <local:ScalingDialogContentView DataContext="{Binding}" />
</Window>
