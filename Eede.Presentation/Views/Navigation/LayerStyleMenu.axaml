<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Eede.Presentation.Views.Navigation.LayerStyleMenu">
  <Grid>
    <Grid.Styles>
      <StyleInclude Source="/Styles/Styles.axaml" />
    </Grid.Styles>
    <WrapPanel>
      <ToggleButton x:Name="ButtonRgb" Classes="tool" Click="SetRgbLayer" ToolTip.Tip="RGBレイヤースタイル(F1)" >
        <Image Source="avares://Eede.Presentation/Assets/Tools/layer_rgb.png" Stretch="None" />
      </ToggleButton>
      <ToggleButton x:Name="ButtonAlpha" Classes="tool" Click="SetAlphaLayer" ToolTip.Tip="Alphaレイヤースタイル(F2)" >
        <Image Source="avares://Eede.Presentation/Assets/Tools/layer_alpha.png" Stretch="None" />
      </ToggleButton>
      <ToggleButton x:Name="ButtonArgb" Classes="tool" Click="SetArgbLayer" ToolTip.Tip="ARGBレイヤースタイル(F3)" >
        <Image Source="avares://Eede.Presentation/Assets/Tools/layer_full.png" Stretch="None" />
      </ToggleButton>
    </WrapPanel>
  </Grid>
</UserControl>
