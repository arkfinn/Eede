<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:Eede.Presentation.ViewModels.Pages"
			 xmlns:local="clr-namespace:Eede.Presentation.Views.Pages"
			 xmlns:navi="clr-namespace:Eede.Presentation.Views.Navigation"
			 xmlns:entry="clr-namespace:Eede.Presentation.Views.DataEntry"
			 xmlns:display="clr-namespace:Eede.Presentation.Views.DataDisplay"
			 xmlns:general="clr-namespace:Eede.Presentation.Views.General"
			 xmlns:animations="clr-namespace:Eede.Presentation.Views.Animations"
			 xmlns:converters="using:Eede.Presentation.Common.Converters"
			 xmlns:p="using:Eede.Domain.ImageEditing.DrawingTools"
			 xmlns:geo="using:Eede.Domain.ImageEditing.GeometricTransformations"
			 xmlns:ext="using:Eede.Presentation.Common.MarkupExtensions"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
			 x:Class="Eede.Presentation.Views.Pages.MainView"
			 x:DataType="vm:MainViewModel"
			 DataContext="{ext:ServiceResolve vm:MainViewModel}"
			 DragDrop.AllowDrop="True">
	<UserControl.KeyBindings>
		<!-- Undo / Redo -->
		<KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
		<KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
		<KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
		<!-- File Operations -->
		<KeyBinding Gesture="Ctrl+N" Command="{Binding CreateNewPictureCommand}" />
		<KeyBinding Gesture="Ctrl+O" Command="{Binding LoadPictureCommand}" />
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SavePictureCommand}" />
		<KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SavePictureAsCommand}" />
		<!-- Clipboard & Selection -->
		<KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
		<KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
		<KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
		<KeyBinding Gesture="Escape" Command="{Binding DeselectCommand}" />
		<KeyBinding Gesture="Ctrl+D" Command="{Binding DeselectCommand}" />
		<!-- Shape Modifiers -->
		<KeyBinding Gesture="Shift+U" Command="{Binding SetDrawStyleCommand}" CommandParameter="{x:Static p:DrawStyleType.FilledRectangle}" />
		<KeyBinding Gesture="Shift+R" Command="{Binding SetDrawStyleCommand}" CommandParameter="{x:Static p:DrawStyleType.FilledRectangle}" />
		<KeyBinding Gesture="Shift+C" Command="{Binding SetDrawStyleCommand}" CommandParameter="{x:Static p:DrawStyleType.FilledEllipse}" />
		<!-- Geometric Transformations -->
		<KeyBinding Gesture="Shift+H" Command="{Binding PictureActionCommand}" CommandParameter="{x:Static geo:PictureActions.FlipHorizontal}" />
		<KeyBinding Gesture="Shift+V" Command="{Binding PictureActionCommand}" CommandParameter="{x:Static geo:PictureActions.FlipVertical}" />
		<KeyBinding Gesture="Ctrl+R" Command="{Binding PictureActionCommand}" CommandParameter="{x:Static geo:PictureActions.RotateRight}" />
		<KeyBinding Gesture="Alt+H" Command="{Binding PictureActionCommand}" CommandParameter="{x:Static geo:PictureActions.MirrorCopyRight}" />
		<KeyBinding Gesture="Alt+V" Command="{Binding PictureActionCommand}" CommandParameter="{x:Static geo:PictureActions.MirrorCopyBottom}" />
		<KeyBinding Gesture="Ctrl+T" Command="{Binding ScalingCommand}" />
		<KeyBinding Gesture="Ctrl+Alt+A" Command="{Binding PictureActionCommand}" CommandParameter="{x:Static geo:PictureActions.AntiAliasStrong}" />
		<KeyBinding Gesture="Ctrl+Shift+Alt+A" Command="{Binding PictureActionCommand}" CommandParameter="{x:Static geo:PictureActions.AntiAliasSubtle}" />
		<!-- View, Grid & Transparency -->
		<KeyBinding Gesture="Alt+T" Command="{Binding ToggleTransparencyCommand}" />
		<KeyBinding Gesture="Ctrl+OemQuotes" Command="{Binding TogglePixelGridCommand}" />
		<KeyBinding Gesture="Shift+G" Command="{Binding TogglePixelGridCommand}" />
		<KeyBinding Gesture="Ctrl+OemSemicolon" Command="{Binding ToggleCursorGridCommand}" />
		<KeyBinding Gesture="Alt+G" Command="{Binding ToggleCursorGridCommand}" />
		<KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetZoomCommand}" />
		<KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
		<KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
		<KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
		<!-- Document & Tab Management -->
		<KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActivePictureCommand}" />
		<!-- Layer Styles -->
		<KeyBinding Gesture="F1" Command="{Binding SetLayerStyleRgbCommand}" />
		<KeyBinding Gesture="F2" Command="{Binding SetLayerStyleAlphaCommand}" />
		<KeyBinding Gesture="F3" Command="{Binding SetLayerStyleArgbCommand}" />
		<!-- Animation & Workspace -->
		<KeyBinding Gesture="F4" Command="{Binding ToggleAnimationPanelCommand}" />
		<KeyBinding Gesture="Ctrl+E" Command="{Binding ToggleAnimationPanelCommand}" />
		<KeyBinding Gesture="Ctrl+OemOpenBrackets" Command="{Binding DecreaseMinCursorSizeCommand}" />
		<KeyBinding Gesture="Ctrl+OemCloseBrackets" Command="{Binding IncreaseMinCursorSizeCommand}" />
	</UserControl.KeyBindings>
	<UserControl.Resources>
		<converters:BackgroundColorConverter x:Key="BackgroundColorConverter"/>
	</UserControl.Resources>
	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainViewModel FileStorage="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:MainView}}}" />
	</Design.DataContext>
	<Panel Background="Transparent">
		<Panel.Styles>
			<StyleInclude Source="/Styles/Styles.axaml" />
		</Panel.Styles>
		<DockPanel LastChildFill="True">

			<!-- クラッシュリカバリー通知バナー -->
			<Border DockPanel.Dock="Top"
					Background="#2a2215"
					BorderBrush="#d48806"
					BorderThickness="0,0,0,1"
					Padding="16,6"
					IsVisible="{Binding IsRecoveryPromptVisible}">
				<Grid ColumnDefinitions="Auto,*,Auto,Auto">
					<TextBlock Grid.Column="0"
							   Text="⚠️"
							   FontSize="14"
							   VerticalAlignment="Center"
							   Margin="0,0,10,0" />
					<TextBlock Grid.Column="1"
							   Text="{Binding RecoveryPromptMessage}"
							   VerticalAlignment="Center"
							   FontSize="13"
							   TextWrapping="Wrap" />
					<Button Grid.Column="2"
							Content="前回の作業を復元"
							Command="{Binding RestoreRecoveryCommand}"
							Margin="12,0,6,0"
							Classes="accent"
							VerticalAlignment="Center" />
					<Button Grid.Column="3"
							Content="破棄"
							Command="{Binding DiscardRecoveryCommand}"
							Margin="2,0,0,0"
							VerticalAlignment="Center" />
				</Grid>
			</Border>

			<Grid ColumnDefinitions="*, 4, *" DockPanel.Dock="Bottom">
				<DockPanel Grid.Column="0" LastChildFill="True">
					<Panel DockPanel.Dock="Top" >
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center"
									Margin="2">
							<Button Classes="tool" Command="{Binding UndoCommand}" ToolTip.Tip="元に戻す(Ctrl+Z)">
									<PathIcon Data="{StaticResource UndoIconGeometry}" Classes="icon" />
							</Button>
							<Button Classes="tool" Command="{Binding RedoCommand}" ToolTip.Tip="やり直し(Ctrl+Y)">
								<PathIcon Data="{StaticResource RedoIconGeometry}" Classes="icon" />
							</Button>
							<Panel Classes="horizontal-separator" />
							<Button Classes="tool" Command="{Binding CopyCommand}" ToolTip.Tip="コピー(Ctrl+C): 選択範囲をクリップボードにコピー">
								<PathIcon Data="{StaticResource ContentCopyIconGeometry}" Classes="icon" />
							</Button>
							<Button Classes="tool" Command="{Binding CutCommand}" ToolTip.Tip="切り取り(Ctrl+X): 選択範囲を切り取ってクリップボードに保存">
								<PathIcon Data="{StaticResource ContentCutIconGeometry}" Classes="icon" />
							</Button>
							<Button Classes="tool" Command="{Binding PasteCommand}" ToolTip.Tip="貼り付け(Ctrl+V): クリップボードの内容を現在のキャンバスに貼り付け">
								<PathIcon Data="{StaticResource ContentPasteIconGeometry}" Classes="icon" />
							</Button>
							<Panel Classes="horizontal-separator" />
							<navi:LayerStyleMenu ImageTransfer="{Binding ImageTransfer}"
												 ImageBlender="{Binding ImageBlender}"/>
							<Panel Classes="horizontal-separator" />
							<navi:MagnificationMenu Magnification="{Binding Magnification}"/>
							<Panel Classes="horizontal-separator" />
							<ToggleButton Classes="tool" IsChecked="{Binding IsShowPixelGrid}" ToolTip.Tip="1pxグリッドを表示">
								<PathIcon Data="{StaticResource BackgroundGridSmallIconGeometry}" Classes="icon" />
							</ToggleButton>
							<ToggleButton Classes="tool" IsChecked="{Binding IsShowCursorGrid}" ToolTip.Tip="カーソルグリッドを表示">
								<PathIcon Data="{StaticResource GridViewIconGeometry}" Classes="icon" />
							</ToggleButton>
						</StackPanel>
					</Panel>

					<Panel DockPanel.Dock="Right" Margin="2" Width="24">
						<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
							<navi:PictureActionMenu Command="{Binding PictureActionCommand}" ScalingCommand="{Binding ScalingCommand}"/>
							<Panel Classes="vertical-separator" />
							<ToggleButton Classes="tool" IsChecked="{Binding IsTransparencyEnabled}" ToolTip.Tip="透過を有効にする">
								<PathIcon Data="{StaticResource BlurOnIconGeometry}" Classes="icon" />
							</ToggleButton>
						</StackPanel>
					</Panel>

					<Panel DockPanel.Dock="Bottom" Background="Transparent">
						<StackPanel Orientation="Horizontal">
							<Panel>
								<entry:PaletteContainer DataContext="{Binding PaletteContainerViewModel}"
														FileStorage="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:MainView}}}"
														Margin="4 2 4 8"/>
							</Panel>
							<Panel Margin="0" Width="100" />
						</StackPanel>
					</Panel>

					<Panel DockPanel.Dock="Left" Margin="0" Width="100">
						<StackPanel Orientation="Vertical">
							<navi:DrawStyleMenu Margin="2" DrawStyle="{Binding DrawStyle}" />
							<entry:PenWidthSelector Margin="2" PenWidth="{Binding PenWidth}"/>
							<entry:ColorPicker Margin="2" NowColor="{Binding PenColor}"/>
							<StackPanel Orientation="Horizontal" Margin="2">
								<Panel VerticalAlignment="Center">
									<TextBlock Margin="4" Text="現在色" />
								</Panel>
								<Border Background="Gray"
										BorderBrush="Gray"
										BorderThickness="1"
										CornerRadius="0"
										Padding="0" Margin="4">
									<Panel Width="32" Height="20">
										<Panel.Background>
											<ImageBrush Source="avares://Eede.Presentation/Assets/Tiles/InvisibleBackground.png"
														Stretch="None"
														TileMode="Tile"
														SourceRect="0,0,16,16"
														DestinationRect="0,0,16,16"
														AlignmentY="Top"
														AlignmentX="Left"/>
										</Panel.Background>
										<Panel Width="32" Height="20">
											<Panel.Background>
												<SolidColorBrush Color="{Binding NowPenColor}"/>
											</Panel.Background>
										</Panel>
									</Panel>
								</Border>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Margin="2">
								<Panel VerticalAlignment="Center">
									<TextBlock Margin="4" Text="背景色" />
								</Panel>
								<general:ColorSampleButton SampleColor="{Binding CurrentBackgroundColor, Converter={StaticResource BackgroundColorConverter}}"
														   PutCommand="{Binding PutBackgroundColorCommand}"
														   GetCommand="{Binding GetBackgroundColorCommand}"/>
							</StackPanel>
						</StackPanel>
					</Panel>


					<ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
						<DockPanel LastChildFill="True" >

							<entry:DrawableCanvas DockPanel.Dock="Bottom"
												  Background="{Binding BackgroundColor}"
												  DataContext="{Binding DrawableCanvasViewModel}"/>
						</DockPanel>
					</ScrollViewer>

				</DockPanel>
				<GridSplitter Grid.Column="1" Background="Black" ResizeDirection="Columns"/>
				<Grid Grid.Column="2" ColumnDefinitions="*, Auto" VerticalAlignment="Stretch">
					<DockPanel Grid.Column="0" LastChildFill="True">
						<Panel DockPanel.Dock="Top">
							<StackPanel Orientation="Horizontal" Margin="2">
								<Button Classes="tool"
										ToolTip.Tip="新規作成(Ctrl+N)"
										Command="{Binding CreateNewPictureCommand}">
									<PathIcon Data="{StaticResource NoteAddIconGeometry}" Classes="icon" />
								</Button>
								<Button Classes="tool"
										ToolTip.Tip="開く(Ctrl+O)"
										Command="{Binding LoadPictureCommand}"
										CommandParameter="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:MainView}}}">
									<PathIcon Data="{StaticResource FolderOpenIconGeometry}" Classes="icon" />
								</Button>
								<!-- Desktop 保存ボタン群 -->
								<Button Classes="tool"
										ToolTip.Tip="保存(Ctrl+S)"
										IsVisible="{Binding IsDesktopPlatform}"
										Command="{Binding SavePictureCommand}"
										CommandParameter="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:MainView}}}">
									<PathIcon Data="{StaticResource SaveIconGeometry}" Classes="icon" />
								</Button>
								<Button Classes="tool"
										ToolTip.Tip="名前を付けて保存(Ctrl+Shift+S)"
										IsVisible="{Binding IsDesktopPlatform}"
										Command="{Binding SavePictureAsCommand}"
										CommandParameter="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:MainView}}}">
									<PathIcon Data="{StaticResource SaveAsIconGeometry}" Classes="icon" />
								</Button>

								<!-- Web/Browser ダウンロードボタン -->
								<Button Classes="tool"
										ToolTip.Tip="画像をダウンロード(Ctrl+S)"
										IsVisible="{Binding IsBrowserPlatform}"
										Command="{Binding SavePictureCommand}"
										CommandParameter="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:MainView}}}">
									<PathIcon Data="{StaticResource DownloadIconGeometry}" Classes="icon" />
								</Button>
								<Panel Classes="horizontal-separator" />
								<ComboBox ItemsSource="{Binding MinCursorSizeList}"
										  SelectedItem="{Binding MinCursorWidth, Mode=TwoWay}"/>
								<TextBlock VerticalAlignment="Center" Text=" x "/>
								<ComboBox ItemsSource="{Binding MinCursorSizeList}"
										  SelectedItem="{Binding MinCursorHeight, Mode=TwoWay}"/>
								                                                                <Panel Classes="horizontal-separator" />
								                                                                <ComboBox x:Name="ThemeSelect" SelectedIndex="{Binding SelectedThemeIndex}" SelectionChanged="OnClickThemeSelect">
								                                                                        <ComboBoxItem>Light</ComboBoxItem>
								                                                                        <ComboBoxItem>Dark</ComboBoxItem>
								                                                                </ComboBox>
								                                                                <Button Classes="tool"
								                                                                        IsVisible="{Binding IsUpdateReady}"
								                                                                        Command="{Binding ApplyUpdateCommand}"
								                                                                        ToolTip.Tip="新しいバージョンが利用可能です。クリックして再起動し、適用します。">
								                                                                        <PathIcon Data="{StaticResource SyncIconGeometry}" Classes="icon" Foreground="{DynamicResource SystemAccentColor}" />
								                                                                </Button>
								                                                        </StackPanel>						</Panel>
						<display:PictureFrame Pictures="{Binding Pictures}"
											  ActiveDockable="{Binding ActiveDockable, Mode=TwoWay}"
											  ImageBlender="{Binding PullBlender}"
											  BackgroundColor="{Binding CurrentBackgroundColor.Value}"
											  WelcomeViewModel="{Binding WelcomeViewModel}"/>
					</DockPanel>

					<!-- Collapsible Panel -->
					<Grid Grid.Column="1" ColumnDefinitions="Auto, 24" VerticalAlignment="Stretch">
						<!-- Content Area -->
						<Border Grid.Column="0" Width="220" IsVisible="{Binding IsAnimationPanelExpanded}"
								BorderBrush="{DynamicResource BaseBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource RegionBrush}">
							<Grid RowDefinitions="Auto, *">
								<animations:AnimationPreviewView Grid.Row="0"
																 DataContext="{Binding AnimationViewModel}"
																 FileStorage="{Binding FileStorage, RelativeSource={RelativeSource AncestorType={x:Type local:MainView}}}"
																 Width="220" />
								<animations:AnimationSequencerView Grid.Row="1" DataContext="{Binding AnimationViewModel}" Width="220" />
							</Grid>
						</Border>

						<!-- Slim Bar Button -->
						<ToggleButton Grid.Column="1"
									  IsChecked="{Binding IsAnimationPanelExpanded}"
									  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
									  Padding="0"
									  Background="{DynamicResource RegionBrush}"
									  BorderBrush="{DynamicResource BaseBrush}"
									  BorderThickness="1,0,0,0"
									  CornerRadius="0">
							<ToggleButton.Styles>
								<Style Selector="ToggleButton">
									<Setter Property="Template">
										<ControlTemplate>
											<Border Background="{TemplateBinding Background}"
													BorderBrush="{TemplateBinding BorderBrush}"
													BorderThickness="{TemplateBinding BorderThickness}">
												<LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Top">
													<LayoutTransformControl.LayoutTransform>
														<RotateTransform Angle="-90"/>
													</LayoutTransformControl.LayoutTransform>
													<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0">
														<TextBlock Text="Animation Panel" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Bold"/>
														<TextBlock Text="{Binding IsAnimationPanelExpanded, Converter={StaticResource PlayPauseTextConverter}, ConverterParameter='arrow'}"
																   Foreground="{DynamicResource TextBrush}" FontSize="12"/>
													</StackPanel>
												</LayoutTransformControl>
											</Border>
										</ControlTemplate>
									</Setter>
								</Style>
							</ToggleButton.Styles>
						</ToggleButton>
					</Grid>
				</Grid>
			</Grid>
		</DockPanel>

		<!-- Web/SingleView 用モーダルダイアログオーバーレイ -->
		<Panel x:Name="ModalOverlayHost"
			   Background="#B0000000"
			   IsVisible="False"
			   ZIndex="1000">
			<Border Background="#201f1f"
					BorderBrush="{DynamicResource OutlineVariantBrush}"
					BorderThickness="1"
					CornerRadius="8"
					BoxShadow="0 8 32 #A0000000"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					MinWidth="320"
					MaxWidth="500">
				<ContentControl x:Name="ModalContentControl" Background="#201f1f" />
			</Border>
		</Panel>
	</Panel>
</UserControl>
