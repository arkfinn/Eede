<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Eede.Presentation.ViewModels.Pages"
             xmlns:controls="using:Eede.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="250"
             x:Class="Eede.Presentation.Views.Pages.NewPictureView"
             x:DataType="vm:NewPictureWindowViewModel"
             Background="#201f1f">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="新規ピクチャのサイズを指定してください" FontWeight="Bold"/>

    <StackPanel>
      <TextBlock Text="Width:" Margin="0,0,0,5"/>
      <NumericUpDown Value="{Binding Width}" Increment="4" Minimum="1"/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Height:" Margin="0,0,0,5"/>
      <NumericUpDown Value="{Binding Height}" Increment="4" Minimum="1"/>
    </StackPanel>

    <controls:DialogButtons PrimaryText="OK"
                            PrimaryCommand="{Binding ConfirmCommand}"
                            CancelCommand="{Binding CancelCommand}"
                            Margin="0,20,0,0" />
  </StackPanel>
</UserControl>
