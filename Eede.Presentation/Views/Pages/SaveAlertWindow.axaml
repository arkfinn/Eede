<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Eede.Views.Pages"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="130"
        x:Class="Eede.Views.Pages.SaveAlertWindow"
        x:DataType="local:SaveAlertWindow"
        MinWidth="400"
        Width="400"
        MinHeight="130"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Title="Eede">
  <local:SaveAlertContentView DataContext="{Binding}" />
</Window>
