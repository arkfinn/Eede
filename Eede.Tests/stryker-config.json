{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/Options/stryker-config.schema.json",
  "stryker-config": {
    "project": "Eede.Domain.csproj",
    "target-framework": "net10.0",
    "reporters": [
      "Progress",
      "ClearText",
      "Html",
      "Json"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "ImageEditing/Blending/**/*.cs"
    ]
  }
}
